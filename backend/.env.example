# Get this by running: claude setup-token
# Then copy the token value shown and paste it here
CLAUDE_CODE_OAUTH_TOKEN=your_oauth_token_here

ORION_MODEL=claude-sonnet-4-6
ORION_TTS_RATE=185
ORION_TTS_VOLUME=0.95
WHISPER_MODEL=small
WHISPER_DEVICE=cuda

# Groq - free tier, whisper-large-v3-turbo (much better STT accuracy)
# Sign up free at console.groq.com -> API Keys -> Create key
GROQ_API_KEY=your_groq_api_key_here

# Location override (IP geolocation is unreliable in India)
ORION_CITY=YourCity
ORION_REGION=YourRegion
ORION_COUNTRY=YourCountry
ORION_LAT=00.0000
ORION_LON=00.0000
ORION_TIMEZONE=Asia/Kolkata
